<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below: auto-backup keeps the database, but not the lock
     state (flutter_secure_storage), whose keys never leave the Keystore. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
</full-backup-content>
